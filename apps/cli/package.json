{
  "name": "@modernizer/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "the-modernizer": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --watch dist/index.js",
    "start": "tsx src/index.ts",
    "build": "tsc",
