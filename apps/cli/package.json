    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@modernizer/crawler": "workspace:*",
    "@modernizer/extractor": "workspace:*",
    "@modernizer/generator": "workspace:*",
    "@modernizer/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^14.0.3",
    "dotenv": "^17.4.1"
  }
}
